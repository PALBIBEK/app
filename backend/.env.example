# BFF local defaults for AI plane smoke (Phase 1C).
# Copy to backend/.env (gitignored) and adjust as needed.
# Never commit real secrets. These values match root docker-compose.yml defaults.

# Point BFF at local supervisor (docker compose maps 8080).
AI_SUPERVISOR_BASE_URL=http://127.0.0.1:8080

# Must match supervisor SERVICE_JWT_SECRET / AI_SERVICE_JWT_SECRET in compose.
AI_SERVICE_JWT_SECRET=dev-local-service-jwt-secret-32b!!

# Optional: same secret under compose-style name for local scripts.
SERVICE_JWT_SECRET=dev-local-service-jwt-secret-32b!!
