# Backend API (browser-visible, non-secret)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# FORBIDDEN for D1: never put AI plane URLs or tokens in NEXT_PUBLIC_*
# The browser talks only to the system BFF. Service JWTs stay server-side.
# NEXT_PUBLIC_SUPERVISOR_URL=  # do not enable
# NEXT_PUBLIC_MEMORY_SERVICE_URL=
# NEXT_PUBLIC_MODEL_GATEWAY_URL=
# NEXT_PUBLIC_AUTH_TOKEN=

# Feature Flags
NEXT_PUBLIC_ENABLE_REAL_TIME=true
NEXT_PUBLIC_ENABLE_TRACES=true
NEXT_PUBLIC_ENABLE_SUBAGENTS=true
