{
  "name": "yal-agent-platform-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "test:phase0": "node --test scripts/phase0-scaffold.test.mjs",
    "typecheck": "pnpm -r run typecheck",
    "build": "pnpm -r run build",
    "dev": "pnpm --filter @yal/app-web dev",
    "check:node": "node -e \"const M=process.versions.node.split('.')[0]; if(M!=='22'){console.error('Node 22 required, got',process.versions.node); process.exit(1)}\"",
    "test:phase1": "node --test scripts/phase1-foundation.test.mjs",
    "test": "pnpm run test:phase0 && pnpm run test:phase1",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-boundaries": "^5.0.1",
    "prettier": "^3.5.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.26.1"
  }
}
