{
  "name": "@yal/tokens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tokens.css": "./dist/tokens.css",
    "./dist/tokens.css": "./dist/tokens.css",
    "./dist/tokens.ts": "./dist/tokens.ts",
    "./dist/tokens.json": "./dist/tokens.json"
  },
  "scripts": {
    "build": "node style-dictionary.config.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:stale": "node style-dictionary.config.mjs && git diff --exit-code -- dist/ || (echo 'tokens dist is stale — commit packages/tokens/dist' && exit 1)"
  },
  "devDependencies": {
    "style-dictionary": "^4.3.3"
  }
}
