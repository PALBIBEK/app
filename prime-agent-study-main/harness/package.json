{
  "name": "@yal/agent-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Versioned Pi harness extensions for the YAL supervisor",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:binds": "npm run build && node scripts/check-binds.mjs",
    "check:memory": "npm run build && node scripts/check-memory.mjs",
    "test:durable-memory": "npm run build && node --test dist/extensions/memory/durable/adapter.test.js",
    "test:memory-hooks": "npm run build && node --test dist/extensions/memory/hooks.test.js",
    "recompute-digests": "python3 scripts/recompute-digests.py"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^7.0.2"
  }
}
