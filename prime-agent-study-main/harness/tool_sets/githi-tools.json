    "edit": "sha256:2338c52f03aa2ef6c52e9759eed0fb7502b607bc82c2b9cfd25bc842c660e1bb",
    "grep": "sha256:950438d4b6950562e5f912c8ffadf7bcdf70f4dd0e578e7bd00214c822d7d160",
    "ls": "sha256:e72466adfec28f058e67bb89fe28d68799d4df4db0059d69845ad76a45b7a69d",
    "read": "sha256:51c6058a3253bbcec16607c9768f7559b4ae4dd025e9471a6d30aa26acd8be3c",
    "remember": "sha256:a3b3a6117c9fba738dbcc8c1da69877138b3e1760b44b30ffe32898c41254419",
    "write": "sha256:a4c935f399fee0d550c09d3d66f693d83bd56a51eeb7b522980b03fd6e3e6260"
  }
}
