# Local settings for ./dev.sh. The first run copies this to .env.local (gitignored)
# and fills every secret below with a random value. Edit .env.local, not this file.

# Shared by the backend (signs service tokens) and the supervisor (checks them).
SERVICE_JWT_SECRET=
# The backend's own user-session signing key.
BACKEND_SECRET_KEY=
CAPABILITY_SECRET=
# Between the supervisor and its model gateway, and its memory service.
GATEWAY_TOKEN=
MEMORY_SERVICE_TOKEN=

# The demo login ./dev.sh creates.
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=demo-password-123

# Optional real model. Without a key every harness uses the `echo` model.
# The key is given to the model gateway process only.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=poolside/laguna-s-2.1:free
OPENROUTER_CONTEXT_WINDOW=128000

# Postgres (started with Docker if nothing listens on this port).
DEV_PG_PORT=5433
DEV_PG_USER=yal
DEV_PG_PASSWORD=yal

# Encrypted workflow history (optional): 32 bytes as base64, e.g. `openssl rand -base64 32`.
# Every client and worker must hold it. Add or rotate a key in two rolling restarts:
# first put the new key in TEMPORAL_CODEC_OLD_KEYS everywhere (it opens, nothing seals with
# it yet), then make it TEMPORAL_CODEC_KEY everywhere, keeping the previous one as old.
TEMPORAL_CODEC_KEY=
TEMPORAL_CODEC_OLD_KEYS=
